{
  "name": "finpal-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "FinPal - 基金投资助手 (Monorepo)",
  "scripts": {
    "dev": "docker compose up -d postgres && next dev",
    "dev:web": "next dev",
    "dev:local": "docker compose up -d postgres scheduler && next dev",
    "dev:scheduler": "cd apps/scheduler && python -m src.main",
    "build": "next build",
    "up": "./run.sh up",
    "down": "./run.sh down",
    "logs": "./run.sh logs",
    "db: studio": "npx pg-admin",
    "scheduler:trigger": "curl -X POST http://localhost:8001/trigger",
    "scheduler:stats": "curl http://localhost:8001/stats",
    "clean": "docker compose down -v && pnpm -r exec rm -rf node_modules .next dist",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.19.13",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.5.8",
    "tailwindcss": "4.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "dependencies": {
    "@langchain/core": "1.1.26",
    "@langchain/langgraph": "1.1.5",
    "@langchain/openai": "1.2.8",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.576.0",
    "mermaid": "^11.13.0",
    "next": "16.1.6",
    "openai": "^6.27.0",
    "pg": "^8.20.0",
    "playwright": "^1.58.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.3.6"
  }
}