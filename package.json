{
  "name": "finpal-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "FinPal - 基金投资助手 (Monorepo)",
  "scripts": {
    "dev": "docker compose up -d postgres && pnpm dev:web",
    "dev:web": "pnpm --filter finpal dev",
    "dev:scheduler": "cd apps/scheduler && python -m src.main",
    
    "build": "docker compose build",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    
    "db:migrate": "cd apps/web && npx prisma migrate dev",
    "db:generate": "cd apps/web && npx prisma generate",
    "db:studio": "cd apps/web && npx prisma studio",
    
    "scheduler:trigger": "curl -X POST http://localhost:8001/trigger",
    "scheduler:stats": "curl http://localhost:8001/stats",
    
    "clean": "docker compose down -v && pnpm -r exec rm -rf node_modules .next dist"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "concurrently": "^8.2.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
