# LLM Configuration (DashScope - 阿里云百炼)
OPENAI_API_KEY=your_dashscope-api-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.5-plus

# Vision LLM Configuration (for image analysis)
# 如果不设置，默认使用上面的 OPENAI_API_KEY 和 OPENAI_BASE_URL
# DASHSCOPE_API_KEY=your_dashscope-api-key-here
# VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_MODEL_NAME=qwen-vl-max

# Alibaba Cloud Qwen Web Search (Optional)
# Enable LLM-based web search using Qwen models
# DASHSCOPE_API_KEY=your-dashscope-api-key-here

# Proxy Configuration (Optional)
# Supports both HTTP_PROXY/HTTPS_PROXY and http_proxy/https_proxy
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
# Or:
# http_proxy=http://127.0.0.1:7890
# https_proxy=http://127.0.0.1:7890

# Default Search Engine (Optional)
# Options: smart (default), duckduckgo, aliyun-websearch
# DEFAULT_SEARCH_ENGINE=smart
