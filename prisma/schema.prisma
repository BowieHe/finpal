generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 基金基础信息（主键是 code，与 Python scheduler 建表一致）
model FundBasic {
  code            String    @id @db.VarChar(10)
  name            String    @db.VarChar(100)
  category        String?   @db.VarChar(50)
  manager         String?   @db.VarChar(50)
  company         String?   @db.VarChar(100)
  establishedDate DateTime? @map("established_date") @db.Timestamp(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  navs FundNav[]

  @@index([name], map: "idx_fund_basic_name")
  @@map("fund_basic")
}

/// 基金净值（每日 T+1 同步）
model FundNav {
  id          Int      @id @default(autoincrement())
  fundCode    String   @map("fund_code") @db.VarChar(10)
  navDate     DateTime @map("nav_date") @db.Timestamp(6)
  unitNav     Decimal  @map("unit_nav") @db.Decimal(10, 4)
  accumNav    Decimal  @map("accum_nav") @db.Decimal(10, 4)
  dailyReturn Decimal? @map("daily_return") @db.Decimal(6, 2)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  fund FundBasic @relation(fields: [fundCode], references: [code])

  @@unique([fundCode, navDate])
  @@index([fundCode], map: "idx_fund_nav_code")
  @@index([navDate], map: "idx_fund_nav_date")
  @@map("fund_nav")
}


/// 用户持仓（单用户系统，无 user_id）
model UserHolding {
  id        String   @id @default(cuid())
  fundCode  String   @map("fund_code") @db.VarChar(10)
  fundName  String   @map("fund_name") @db.VarChar(100)
  shares    Decimal  @db.Decimal(15, 4)
  costPrice Decimal  @map("cost_price") @db.Decimal(10, 4)
  buyDate   DateTime @map("buy_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions HoldingTransaction[]

  @@index([fundCode])
  @@map("user_holdings")
}

/// 持仓交易记录（分批买入/卖出）
model HoldingTransaction {
  id        String   @id @default(cuid())
  holdingId String   @map("holding_id")
  type      String   @db.VarChar(10)    // 'buy' | 'sell'
  date      DateTime
  shares    Decimal  @db.Decimal(15, 4)
  price     Decimal  @db.Decimal(10, 4)
  amount    Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now()) @map("created_at")

  holding UserHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@index([holdingId])
  @@map("holding_transactions")
}

/// 全局设置（如 LLM 配置）
model Settings {
  id              Int      @id @default(1)
  apiUrl          String?  @map("api_url")
  modelName       String?  @map("model_name")
  apiKey          String?  @map("api_key")
  dashscopeApiKey String?  @map("dashscope_api_key")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

/// 业力轨迹：记录所有可能影响画像的原子事件
model KarmaLog {
  id              String   @id @default(cuid())
  source          String   // 'screenshot' | 'chat' | 'analysis'
  type            String   // 'behavior' | 'emotion' | 'interest'
  content         String   // 原始事实描述
  interpretation  Json     // AI 对该事件的解读 { "style": "aggressive", "bias": "FOMO" }
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("karma_logs")
}

/// 全局用户画像 (Snapshot)：由 LLM 定期从 KarmaLog 聚合生成的当前状态
model UserProfile {
  id              String   @id @default(cuid())
  version         Int      @default(1)
  persona         String   // 核心底色
  styles          Json     // 风格分布
  biases          String[] // 识别出的偏差历史
  evolutionaryLog String   // 演进日志
  summary         String   // 综合描述
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_profile")
}
